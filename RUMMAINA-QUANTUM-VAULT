<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rummaina Cipher Vault Pro v8.0 (50GB Engine)</title>
    <link rel="manifest" href="data:application/manifest+json,{%22name%22:%22Rummaina%20Cipher%20Vault%22,%22short_name%22:%22CipherVault%22,%22start_url%22:%22.%22,%22display%22:%22standalone%22,%22background_color%22:%22%23010409%22,%22theme_color%22:%22%2300d4ff%22}">
    <style>
        :root {
            --bg-dark: #020613;
            --bg-card: rgba(6, 18, 38, 0.9);
            --border-normal: rgba(0, 212, 255, 0.3);
            --border-pro: rgba(255, 215, 0, 0.6);
            --neon-blue: #00d4ff;
            --pro-gold: #ffd700;
            --pro-glow: #ff8c00;
            --text-main: #f0f6fc;
            --text-muted: #8b949e;
            --danger: #ff2a6d;
            --terminal-green: #00ffaa;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Consolas', 'Fira Code', monospace; }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        #bgCanvas {
            position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: 0; pointer-events: none; opacity: 0.3;
        }

        header {
            position: relative; z-index: 10;
            padding: 15px 30px;
            display: flex; justify-content: space-between; align-items: center;
            border-bottom: 1px solid var(--border-normal);
            background: rgba(2, 6, 19, 0.95);
            backdrop-filter: blur(15px);
            flex-wrap: wrap; gap: 10px;
        }

        .logo { font-size: 1.2rem; font-weight: 900; letter-spacing: 2px; }
        .logo span { color: var(--neon-blue); }
        .logo.pro-mode span { color: var(--pro-gold); text-shadow: 0 0 20px var(--pro-gold); }

        .header-actions { display: flex; align-items: center; gap: 15px; }

        .install-btn {
            background: linear-gradient(135deg, #00ffaa, #0055ff);
            border: none; padding: 8px 16px; border-radius: 20px;
            color: #000; font-weight: bold; font-size: 0.75rem;
            cursor: pointer; box-shadow: 0 0 15px rgba(0, 255, 170, 0.4);
            transition: all 0.3s ease;
        }
        .install-btn:hover { transform: scale(1.05); }

        .tier-toggle {
            display: flex; background: rgba(0,0,0,0.6);
            border: 1px solid var(--border-normal); border-radius: 20px; padding: 3px;
        }

        .toggle-btn {
            padding: 6px 16px; font-size: 0.75rem; border: none; border-radius: 15px;
            cursor: pointer; background: transparent; color: var(--text-muted); font-weight: bold;
            transition: all 0.3s;
        }

        .toggle-btn.active-normal { background: var(--neon-blue); color: #000; }
        .toggle-btn.active-pro { background: var(--pro-gold); color: #000; box-shadow: 0 0 20px var(--pro-gold); }

        main { position: relative; z-index: 10; flex: 1; padding: 25px; max-width: 1400px; margin: 0 auto; width: 100%; }

        .auth-wrapper { max-width: 480px; margin: 40px auto; }
        .auth-card {
            background: var(--bg-card); border: 1px solid var(--border-normal);
            border-radius: 12px; padding: 35px; text-align: center;
            box-shadow: 0 0 40px rgba(0, 212, 255, 0.15);
        }
        .auth-card.pro-border { border-color: var(--pro-gold); box-shadow: 0 0 60px rgba(255, 215, 0, 0.3); }

        .vault-layout { display: grid; grid-template-columns: 380px 1fr; gap: 25px; }
        @media (max-width: 1024px) { .vault-layout { grid-template-columns: 1fr; } }

        .panel {
            background: var(--bg-card); border: 1px solid var(--border-normal);
            border-radius: 12px; padding: 22px; backdrop-filter: blur(20px);
        }
        .panel.pro-panel { border-color: var(--border-pro); box-shadow: 0 0 30px rgba(255, 215, 0, 0.1); }

        .input-group { margin-bottom: 18px; text-align: left; }
        label { display: block; font-size: 0.72rem; color: var(--neon-blue); margin-bottom: 6px; text-transform: uppercase; }
        .pro-label { color: var(--pro-gold) !important; }

        input, select, textarea {
            width: 100%; padding: 12px 14px; background: rgba(1, 4, 9, 0.9);
            border: 1px solid var(--border-normal); border-radius: 6px;
            color: var(--text-main); font-size: 0.9rem; outline: none;
        }

        .btn {
            width: 100%; padding: 12px; background: linear-gradient(135deg, #0055ff, var(--neon-blue));
            border: none; border-radius: 6px; color: #fff; font-weight: bold;
            cursor: pointer; letter-spacing: 1px; text-transform: uppercase;
        }
        .btn-pro { background: linear-gradient(135deg, var(--pro-glow), var(--pro-gold)) !important; color: #000 !important; }

        .transform-box {
            background: rgba(255, 215, 0, 0.05); border: 1px dashed var(--pro-gold);
            padding: 12px; border-radius: 8px; margin-bottom: 18px;
        }

        .secret-card {
            background: rgba(1, 4, 9, 0.8); border: 1px solid var(--border-normal);
            border-radius: 8px; padding: 16px; margin-bottom: 15px;
        }

        .media-preview { max-width: 100%; max-height: 250px; border-radius: 6px; margin-top: 10px; border: 1px solid var(--border-normal); }
        .hidden { display: none !important; }
    </style>
</head>
<body>

    <canvas id="bgCanvas"></canvas>

    <header>
        <div class="logo" id="logoText">⚡ RUMMAINA <span>QUANTUM VAULT</span></div>

        <div class="header-actions">
            <button class="install-btn" id="installBtn" onclick="installPWA()">📲 INSTALL APP (OFFLINE MODE)</button>

            <div class="tier-toggle">
                <button class="toggle-btn active-normal" id="btnNormal" onclick="setTier('normal')">NORMAL (500MB)</button>
                <button class="toggle-btn" id="btnPro" onclick="setTier('pro')">⚡ PRO (50GB ULTRA)</button>
            </div>
        </div>
    </header>

    <main>
        <div class="auth-wrapper" id="authSection">
            <div class="auth-card" id="authCard">
                <h2 id="authTitle" style="color: var(--neon-blue); margin-bottom: 10px;">AUTHENTICATE SYSTEM</h2>
                <p style="color: var(--text-muted); font-size: 0.8rem; margin-bottom: 20px;">Enter PIN to Access Encrypted Storage</p>
                <div class="input-group">
                    <label id="pinLabel">Master PIN</label>
                    <input type="password" id="masterPin" placeholder="Enter Master PIN...">
                </div>
                <button class="btn" id="authBtn" onclick="unlockVault()">Unlock Vault</button>
            </div>
        </div>

        <div class="vault-layout hidden" id="vaultDashboard">

            <div class="panel" id="leftPanel">
                <h3 id="panelTitle" style="color: var(--neon-blue); margin-bottom: 15px;">⚡ ADD NEW CIPHER NOTE</h3>

                <div class="input-group">
                    <label class="dyn-label">Note / File Title</label>
                    <input type="text" id="payloadTitle" placeholder="e.g. Secret Note / Video Title">
                </div>

                <div class="input-group">
                    <label class="dyn-label">Data Type</label>
                    <select id="payloadType" onchange="toggleInputType()">
                        <option value="text">Written Note / Text Secret</option>
                        <option value="image">Image File (PNG/JPG)</option>
                        <option value="video">Video File (MP4/WebM)</option>
                    </select>
                </div>

                <div class="input-group" id="textGroup">
                    <label class="dyn-label">Written Confidential Note</label>
                    <textarea id="payloadText" rows="3" placeholder="Type confidential text note here..."></textarea>
                </div>

                <div class="input-group hidden" id="fileGroup">
                    <label class="dyn-label">Attach File (Pic / Video)</label>
                    <input type="file" id="payloadFile" accept="image/*,video/*">
                </div>

                <div class="transform-box hidden" id="proTransformBox">
                    <label class="pro-label" style="font-weight: bold; margin-bottom: 6px;">⚡ PRO TRANSFORM ENGINE</label>
                    <select id="transformMode">
                        <option value="base64">Mode 1: Base64 Ultra Engine</option>
                        <option value="rot13">Mode 2: ROT13 Crypt Shift</option>
                        <option value="binary">Mode 3: Cyber Binary Matrix (0s & 1s)</option>
                    </select>
                </div>

                <button class="btn" id="saveBtn" onclick="savePayload()">Encrypt & Store</button>

                <div style="margin-top:20px; background:rgba(0,0,0,0.5); padding:10px; border-radius:6px;">
                    <div style="display:flex; justify-content:space-between; font-size:0.75rem;">
                        <span>STORAGE CAPACITY</span>
                        <span id="storageStats">0 / 500 MB</span>
                    </div>
                    <div style="height:6px; background:#222; border-radius:3px; overflow:hidden; margin-top:6px;">
                        <div id="progressFill" style="height:100%; width:0%; background:var(--neon-blue); transition:width 0.4s;"></div>
                    </div>
                </div>
            </div>

            <div class="panel" id="rightPanel">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <h3 id="vaultHeaderTitle" style="color: var(--neon-blue);">🛡️ STORED VAULT ITEMS</h3>
                    <button class="btn" style="width: auto; padding: 6px 14px; font-size: 0.75rem;" onclick="lockVault()">LOCK TERMINAL</button>
                </div>

                <div id="cipherContainer"></div>
            </div>

        </div>
    </main>

    <script>
        let currentTier = "normal";
        let deferredPrompt = null;
        const STORAGE_KEY = "rummaina_vault_v8";

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            document.getElementById('installBtn').style.display = 'block';
        });

        function installPWA() {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                deferredPrompt.userChoice.then((choiceResult) => {
                    if (choiceResult.outcome === 'accepted') {
                        alert("Vault App Installed Successfully!");
                    }
                    deferredPrompt = null;
                });
            } else {
                alert("App is already installed or supported natively via browser menu.");
            }
        }

        if ('serviceWorker' in navigator) {
            const swCode = `
                self.addEventListener('install', e => e.waitUntil(self.skipWaiting()));
                self.addEventListener('fetch', e => e.respondWith(fetch(e.request).catch(() => new Response('Offline'))));
            `;
            const blob = new Blob([swCode], { type: 'application/javascript' });
            navigator.serviceWorker.register(URL.createObjectURL(blob)).catch(() => {});
        }

        function setTier(tier) {
            currentTier = tier;
            const logo = document.getElementById("logoText");
            const btnNormal = document.getElementById("btnNormal");
            const btnPro = document.getElementById("btnPro");
            const authCard = document.getElementById("authCard");
            const authTitle = document.getElementById("authTitle");
            const authBtn = document.getElementById("authBtn");
            const proTransformBox = document.getElementById("proTransformBox");
            const labels = document.querySelectorAll(".dyn-label");

            if (tier === "pro") {
                logo.classList.add("pro-mode");
                btnPro.className = "toggle-btn active-pro";
                btnNormal.className = "toggle-btn";
                authCard.classList.add("pro-border");
                authTitle.style.color = "var(--pro-gold)";
                authBtn.classList.add("btn-pro");
                proTransformBox.classList.remove("hidden");
                labels.forEach(l => l.classList.add("pro-label"));
            } else {
                logo.classList.remove("pro-mode");
                btnNormal.className = "toggle-btn active-normal";
                btnPro.className = "toggle-btn";
                authCard.classList.remove("pro-border");
                authTitle.style.color = "var(--neon-blue)";
                authBtn.classList.remove("btn-pro");
                proTransformBox.classList.add("hidden");
                labels.forEach(l => l.classList.remove("pro-label"));
            }
            updateStorageStats();
        }

        function toggleInputType() {
            const type = document.getElementById("payloadType").value;
            document.getElementById("textGroup").classList.toggle("hidden", type !== "text");
            document.getElementById("fileGroup").classList.toggle("hidden", type === "text");
        }

        function unlockVault() {
            const pin = document.getElementById("masterPin").value;
            if (!pin) return alert("Enter Master PIN!");
            document.getElementById("authSection").classList.add("hidden");
            document.getElementById("vaultDashboard").classList.remove("hidden");
            renderVault();
        }

        function lockVault() {
            document.getElementById("masterPin").value = "";
            document.getElementById("authSection").classList.remove("hidden");
            document.getElementById("vaultDashboard").classList.add("hidden");
        }

        function transformText(text, mode) {
            if (mode === "rot13") {
                return text.replace(/[a-zA-Z]/g, c => String.fromCharCode((c <= "Z" ? 90 : 122) >= (c = c.charCodeAt(0) + 13) ? c : c - 26));
            } else if (mode === "binary") {
                return text.split('').map(char => char.charCodeAt(0).toString(2).padStart(8, '0')).join(' ');
            }
            return btoa(text);
        }

        function reverseTransform(text, mode) {
            if (mode === "rot13") {
                return transformText(text, "rot13");
            } else if (mode === "binary") {
                return text.split(' ').map(bin => String.fromCharCode(parseInt(bin, 2))).join('');
            }
            return atob(text);
        }

        function savePayload() {
            const title = document.getElementById("payloadTitle").value;
            const type = document.getElementById("payloadType").value;

            if (!title) return alert("Title required!");

            if (type === "text") {
                const text = document.getElementById("payloadText").value;
                if (!text) return alert("Enter text note!");
                const mode = currentTier === "pro" ? document.getElementById("transformMode").value : "base64";
                const transformed = transformText(text, mode);
                commitToStorage({ id: Date.now(), title, type, mode, data: transformed });
            } else {
                const fileInput = document.getElementById("payloadFile");
                if (!fileInput.files[0]) return alert("Select a file!");
                const file = fileInput.files[0];
                const limit = currentTier === "pro" ? 2000 * 1024 * 1024 : 100 * 1024 * 1024;

                if (file.size > limit) return alert(`File exceeds limit (${currentTier === "pro" ? "2GB" : "100MB"})`);

                const reader = new FileReader();
                reader.onload = function(e) {
                    commitToStorage({ id: Date.now(), title, type, mode: "raw", data: e.target.result });
                };
                reader.readAsDataURL(file);
            }
        }

        function commitToStorage(record) {
            const existing = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
            existing.push(record);
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(existing));
                document.getElementById("payloadTitle").value = "";
                document.getElementById("payloadText").value = "";
                renderVault();
            } catch (e) {
                alert("Storage Limit Exceeded! Clear old files or delete items.");
            }
        }

        function renderVault() {
            const secrets = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
            const container = document.getElementById("cipherContainer");
            container.innerHTML = "";

            secrets.forEach(item => {
                const div = document.createElement("div");
                div.className = "secret-card";
                let contentHTML = "";

                if (item.type === "text") {
                    contentHTML = `
                        <p id="data-${item.id}" style="color: var(--neon-blue); font-size:0.85rem; margin-top:8px; word-break:break-all;">${item.data}</p>
                        <button class="btn" style="width:auto; padding:4px 10px; font-size:0.7rem; margin-top:8px;" onclick="document.getElementById('data-${item.id}').innerText = reverseTransform('${item.data}', '${item.mode}')">Decrypt Note</button>
                    `;
                } else if (item.type === "image") {
                    contentHTML = `<br><img src="${item.data}" class="media-preview">`;
                } else if (item.type === "video") {
                    contentHTML = `<br><video src="${item.data}" controls class="media-preview"></video>`;
                }

                div.innerHTML = `
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <h4 style="color:#fff;">${item.title} [${item.type.toUpperCase()}]</h4>
                        <button class="btn" style="width:auto; background:var(--danger); padding:4px 10px; font-size:0.7rem;" onclick="deleteRecord(${item.id})">Delete</button>
                    </div>
                    ${contentHTML}
                `;
                container.appendChild(div);
            });
            updateStorageStats();
        }

        function deleteRecord(id) {
            let existing = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");
            existing = existing.filter(i => i.id !== id);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(existing));
            renderVault();
        }

        function updateStorageStats() {
            const dataStr = localStorage.getItem(STORAGE_KEY) || "";
            const usedBytes = new Blob([dataStr]).size;
            const usedMB = (usedBytes / (1024 * 1024)).toFixed(2);
            
            if (currentTier === "pro") {
                const usedGB = (usedBytes / (1024 * 1024 * 1024)).toFixed(3);
                document.getElementById("storageStats").innerText = `${usedGB} / 50 GB`;
                document.getElementById("progressFill").style.width = Math.min((usedGB / 50) * 100, 100) + "%";
            } else {
                document.getElementById("storageStats").innerText = `${usedMB} / 500 MB`;
                document.getElementById("progressFill").style.width = Math.min((usedMB / 500) * 100, 100) + "%";
            }
        }

        const canvas = document.getElementById('bgCanvas');
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth; canvas.height = window.innerHeight;
        const chars = '0110100101RUMMAINAVAULT';
        const drops = Array(Math.floor(canvas.width / 14)).fill(1);

        function drawCanvas() {
            ctx.fillStyle = 'rgba(2, 6, 19, 0.1)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.fillStyle = currentTier === "pro" ? '#ffd700' : '#00d4ff';
            ctx.font = '14px monospace';
            drops.forEach((y, i) => {
                const text = chars.charAt(Math.floor(Math.random() * chars.length));
                ctx.fillText(text, i * 14, y * 14);
                if (y * 14 > canvas.height && Math.random() > 0.975) drops[i] = 0;
                drops[i]++;
            });
        }
        setInterval(drawCanvas, 33);
    </script>
</body>
</html>
